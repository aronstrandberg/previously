[Unit]
Description=opencode-recall: index and search OpenCode sessions (127.0.0.1:4747)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env opencode-recall serve
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
